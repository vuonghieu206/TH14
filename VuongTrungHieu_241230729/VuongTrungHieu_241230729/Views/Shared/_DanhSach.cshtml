@model List<VuongTrungHieu_241230729.Models.Sach>
<div class="section-head">
	<h3>@ViewBag.TieuDe</h3>
	<a href="#">Xem tất cả &rsaquo;</a>
</div>

<div class="grid">
	@foreach (var s in Model)
	{
		<div class="book-card">
			<a href="#"><img src="~/images/@s.Anh" alt="@s.TenSach" /></a>
			<h2>@s.TenSach</h2>
			<div class="book-foot">
				<span class="price">@(s.Gia?.ToString("0"))</span>
				<button class="btn-buy">Them vao gio</button>
			</div>
		</div>
	}
</div>